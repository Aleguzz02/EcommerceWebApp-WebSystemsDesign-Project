<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- ==================== TIPI SEMPLICI ==================== -->
    <xs:simpleType name="IdProdottoType">
        <xs:restriction base="xs:positiveInteger"/>
    </xs:simpleType>

    <xs:simpleType name="PrezzoUnitarioType">
        <xs:restriction base="xs:decimal">
            <xs:minInclusive value="0.01"/>
            <xs:fractionDigits value="2"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="QuantitaType">
        <xs:restriction base="xs:positiveInteger">
            <xs:minInclusive value="1"/>
            <xs:maxInclusive value="99"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="NonEmptyString">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ImmagineType">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ==================== TIPI COMPLESSI ==================== -->
    <xs:complexType name="ElementoType">
        <xs:sequence>
            <xs:element name="idProdotto"     type="IdProdottoType"/>
            <xs:element name="nome"           type="NonEmptyString"/>
            <xs:element name="prezzoUnitario" type="PrezzoUnitarioType"/>
            <xs:element name="quantita"       type="QuantitaType"/>
            <xs:element name="immagine"       type="ImmagineType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CarrelloType">
        <xs:sequence>
            <xs:element name="elemento" type="ElementoType" minOccurs="2" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- ==================== ELEMENTO RADICE ==================== -->
    <xs:element name="carrello" type="CarrelloType">
        <xs:unique name="uniqueIdProdotto">
            <xs:selector xpath="elemento"/>
            <xs:field xpath="idProdotto"/>
        </xs:unique>
    </xs:element>

</xs:schema>